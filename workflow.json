"type\": \"n8n-nodes-base.rssFeedRead\",\n      \"typeVersion\": 1.2,\n      \"position\": [560, 608]\n    },\n    {\n      \"parameters\": {\"url\": \"https://cointelegraph.com/rss\", \"options\": {}},\n      \"id\": \"a566cfda-3b28-4c7e-8289-e319bd84160d\",\n      \"name\": \"Cripto: CoinTelegraph\",\n      \"type\": \"n8n-nodes-base.rssFeedRead\",\n      \"typeVersion\": 1.2,\n      \"position\": [560, 720]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const items=$input.all();const total=items.length;const perFeed=Math.ceil(total/6);const cats=['Ciberseguridad','Ciberseguridad','IA','IA','Finanzas','Finanzas'];const arts=[];for(let f=0;f<6;f++){const start=f*perFeed;const cat=cats[f];for(let i=start;i<Math.min(start+4,items.length);i++){const a=items[i].json;arts.push('['+cat+'] '+(a.title||'')+'\\\\n   '+(a.contentSnippet||a.summary||a.content||'').substring(0,110)+'\\\\n   URL:'+(a.link||''));}}return[{json:{articlesText:arts.join('\\\\n\\\\n'),total:arts.length}}];\"\n      },\n      \"id\": \"56d94c5c-6ad7-4cf1-9d34-943aa23b415e\",\n      \"name\": \"Formatear para IA\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [1152, 432]\n    },\n    {\n      \"parameters\": {\n        \"promptType\": \"define\",\n        \"text\": \"={{ $json.articlesText }}\",\n        \"options\": {\n          \"systemMessage\": \"Eres un redactor experto en tecnologia y finanzas. Tu tarea es compilar las noticias en un boletin matutino en formato HTML.\\n\\nIMPORTANTE: Devuelve UNICAMENTE HTML puro. Absolutamente prohibido usar bloques de codigo markdown.\\n\\nCada articulo tiene una etiqueta [Ciberseguridad], [IA] o [Finanzas]. Usala para asignarlo a la seccion correcta.\\n\\nESTRUCTURA (3 noticias por seccion):\\n<h2>Ciberseguridad</h2><ul><li><strong>Titulo</strong> - Una oracion. <a href=\\\"URL\\\">Ver mas</a></li></ul>\\n<h2>Inteligencia Artificial</h2><ul>...</ul>\\n<h2>Finanzas y Mercados</h2><ul>...</ul>\\n\\nREGLA: Espanol, pero manten en ingles: malware, ransomware, phishing, zero-day, stocks, ETFs, bear market, blockchain, DeFi.\\n\\nCierra con: <blockquote>Frase motivadora corta.</blockquote>\"\n        }\n      },\n      \"id\": \"375fbaa9-1ec7-4cb6-819f-0dbc3a347f64\",\n      \"name\": \"Generar Boletin con Gemini\",\n      \"type\": \"@n8n/n8n-nodes-langchain.agent\",\n      \"typeVersion\": 3.1,\n      \"position\": [1392, 432]\n    },\n    {\n      \"parameters\": {\"options\": {}},\n      \"id\": \"ee07720f-5061-4379-982a-a4df16d68b9b\",\n      \"name\": \"Google Gemini 2.5 Flash\",\n      \"type\": \"@n8n/n8n-nodes-langchain.lmChatGoogleGemini\",\n      \"typeVersion\": 1,\n      \"position\": [1392, 640]\n    },\n    {\n      \"parameters\": {\n        \"fromEmail\": \"YOUR_SENDER_EMAIL@gmail.com\",\n        \"toEmail\": \"YOUR_RECIPIENT_EMAIL@gmail.com\",\n        \"subject\": \"Tu Boletin Matutino: Ciberseguridad, IA y Mercados\",\n        \"emailFormat\": \"html\",\n        \"html\": \"=<!DOCTYPE html><html><head><meta charset=\\\"UTF-8\\\"><style>body{font-family:Georgia,serif;background:#f0f2f5;margin:0;padding:20px}.wrap{max-width:680px;margin:auto;background:white;border-radius:10px;overflow:hidden}.hdr{background:linear-gradient(135deg,#1a1a2e,#16213e);color:white;padding:28px 32px;text-align:center}.body{padding:28px 32px;color:#333;line-height:1.8}h2{color:#1a1a2e;border-bottom:2px solid #e8f0fe;padding-bottom:6px}a{color:#4a6cf7}blockquote{border-left:4px solid #4a6cf7;padding:10px 16px;background:#f8f9ff;font-style:italic}.ftr{padding:14px;text-align:center;color:#888;font-size:12px}</style></head><body><div class=\\\"wrap\\\"><div class=\\\"hdr\\\"><h1>Boletin Matutino</h1><p>{{ $now.setZone(\\\"America/Mexico_City\\\").toFormat(\\\"EEEE d MMMM yyyy\\\") }}</p></div><div class=\\\"body\\\">{{ $json.output }}</div><div class=\\\"ftr\\\">n8n + Google Gemini</div></div></body></html>\",\n        \"options\": {\"appendAttribution\": false}\n      },\n      \"id\": \"41050c4f-5471-4d0a-98fa-ec946a993966\",\n      \"name\": \"Enviar Boletin por SMTP\",\n      \"type\": \"n8n-nodes-base.emailSend\",\n      \"typeVersion\": 2.1,\n      \"position\": [1664, 432]\n    },\n    {\n      \"parameters\": {\n        \"content\": \"## Setup Required\\n\\n1. Timezone: Settings > Timezone > America/Mexico_City\\n2. Gemini credential: aistudio.google.com > API Key > create Google PaLm API credential\\n3. SMTP credential: smtp.gmail.com, port 465, SSL/TLS, Gmail App Password\\n4. Edit fromEmail + toEmail in the SMTP node\",\n        \"height\": 200, \"width\": 440, \"color\": 4\n      },\n      \"id\": \"e1063475-3208-4c7c-8129-25aaf0fccd40\",\n      \"name\": \"Sticky Note\",\n      \"type\": \"n8n-nodes-base.stickyNote\",\n      \"typeVersion\": 1,\n      \"position\": [880, 176]\n    }\n  ],\n  \"pinData\": {},\n  \"connections\": {\n    \"Lunes a Viernes 9:00 AM\": {\"main\": [[{\"node\": \"Ciberseg: BleepingComputer\", \"type\": \"main\", \"index\": 0},{\"node\": \"Ciberseg: Wired Security\", \"type\": \"main\", \"index\": 0},{\"node\": \"IA: TechCrunch AI\", \"type\": \"main\", \"index\": 0},{\"node\": \"IA: VentureBeat\", \"type\": \"main\", \"index\": 0},{\"node\": \"Finanzas: MarketWatch\", \"type\": \"main\", \"index\": 0},{\"node\": \"Cripto: CoinTelegraph\", \"type\": \"main\", \"index\": 0}]]},\n    \"Ciberseg: BleepingComputer\": {\"main\": [[{\"node\": \"Unir Todas las Noticias\", \"type\": \"main\", \"index\": 0}]]},\n    \"Ciberseg: Wired Security\": {\"main\": [[{\"node\": \"Unir Todas las Noticias\", \"type\": \"main\", \"index\": 1}]]},\n    \"IA: TechCrunch AI\": {\"main\": [[{\"node\": \"Unir Todas las Noticias\", \"type\": \"main\", \"index\": 2}]]},\n    \"IA: VentureBeat\": {\"main\": [[{\"node\": \"Unir Todas las Noticias\", \"type\": \"main\", \"index\": 3}]]},\n    \"Finanzas: MarketWatch\": {\"main\": [[{\"node\": \"Unir Todas las Noticias\", \"type\": \"main\", \"index\": 4}]]},\n    \"Cripto: CoinT